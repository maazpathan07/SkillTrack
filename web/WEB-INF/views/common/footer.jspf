<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

    <footer class="st-footer text-center py-4 mt-auto no-print">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center">
            <div class="mb-2 mb-sm-0 small" style="color: #475569;">
                &copy; 2026 <strong class="text-dark">SkillTrack</strong> — Student Skill &amp; Placement Readiness Management Platform.
            </div>
            <div class="small d-flex align-items-center gap-3" style="color: #475569;">
                <span class="st-badge st-badge-secondary mr-2" style="background: rgba(15, 23, 42, 0.08); color: #334155; font-weight: 600;">v1.0.0-PRO</span>
                <span>Secure &amp; Role-Enforced</span>
            </div>
        </div>
    </footer>

    <!-- jQuery 3.6.0 -->
    <script src="${pageContext.request.contextPath}/assets/js/jquery.min.js"></script>
    <!-- Bootstrap 4.6.2 Bundle (Includes Popper) -->
