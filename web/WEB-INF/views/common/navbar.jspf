<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<header class="ios-navbar d-flex align-items-center justify-content-between px-3 px-md-4">
    <!-- Left: Brand -->
    <div class="d-flex align-items-center">
        <a class="ios-brand" href="${pageContext.request.contextPath}/">
            <span class="ios-brand-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
            </span>
            <span>SkillTrack</span>
        </a>
    </div>

    <!-- Center: Modern Capsule Top Navigation Bar (Desktop Only) -->
    <c:if test="${not empty sessionScope.SESSION_USER_ID}">
        <nav class="ios-capsule-nav d-none d-lg-flex align-items-center" aria-label="Main Navigation">
            <c:choose>
                <c:when test="${sessionScope.SESSION_USER_ROLE == 'ADMIN'}">
                    <a class="ios-capsule-link ${activeNav == 'admin-dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/dashboard">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        Dashboard
                    </a>
                    <a class="ios-capsule-link ${activeNav == 'students' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/students">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        Students
                    </a>
                    <a class="ios-capsule-link ${activeNav == 'roles' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/roles">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                        Target Roles
                    </a>
                    <a class="ios-capsule-link ${activeNav == 'skills' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/skills">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        Skills Bank
                    </a>
                    <a class="ios-capsule-link ${activeNav == 'criteria' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/criteria">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        Cutoffs
                    </a>
                    <a class="ios-capsule-link ${activeNav == 'cohort' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/cohort-summary">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                        Cohort Analytics
                    </a>
                </c:when>

                <c:otherwise>
                    <a class="ios-capsule-link ${activeNav == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/dashboard">Dashboard</a>
                    <a class="ios-capsule-link ${activeNav == 'profile' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/profile">Profile</a>
                    <a class="ios-capsule-link ${activeNav == 'skills' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/skills">Skills</a>
                    <a class="ios-capsule-link ${activeNav == 'projects' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/projects">Projects</a>
                    <a class="ios-capsule-link ${activeNav == 'certifications' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/certifications">Certificates</a>
                    <a class="ios-capsule-link ${activeNav == 'dsa' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/dsa">DSA</a>
                    <a class="ios-capsule-link ${activeNav == 'tasks' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/tasks">Checklist</a>
                    <a class="ios-capsule-link ${activeNav == 'skill-gap' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/skill-gap">Skill Gap</a>
                    <a class="ios-capsule-link ${activeNav == 'placement-criteria' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/placement-criteria">Cutoffs</a>
                </c:otherwise>
            </c:choose>
        </nav>
    </c:if>

    <!-- Right Side: User Avatar (Desktop Only) & Mobile Toggle -->
    <div class="d-flex align-items-center">
        <c:choose>
            <c:when test="${not empty sessionScope.SESSION_USER_ID}">
                <!-- Mobile Drawer Toggle Button (Mobile Only) -->
                <button class="ios-mobile-toggle d-lg-none" type="button" id="mobileNavToggleBtn" aria-label="Open Navigation Menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <!-- Desktop User Circular Avatar Trigger (Single 'A' Button) -->
                <div class="dropdown d-none d-lg-block">
                    <div class="rounded-circle d-flex align-items-center justify-content-center font-weight-bold" id="userMenuDropdown" role="button" tabindex="0" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="User account menu" style="width: 38px; height: 38px; background: linear-gradient(135deg, #0071e3, #5856d6); color: #ffffff; font-size: 0.95rem; cursor: pointer; border: 2px solid #ffffff; box-shadow: 0 2px 8px rgba(0, 113, 227, 0.3); transition: var(--ios-ease);">
                        <c:choose>
                            <c:when test="${sessionScope.SESSION_USER_ROLE == 'ADMIN'}">A</c:when>
                            <c:otherwise><c:out value="${fn:substring(sessionScope.SESSION_USER_NAME != null ? sessionScope.SESSION_USER_NAME : 'S', 0, 1)}" /></c:otherwise>
                        </c:choose>
                    </div>

                    <div class="dropdown-menu dropdown-menu-right shadow-lg border-0 mt-2 p-2" aria-labelledby="userMenuDropdown" style="min-width: 230px; border-radius: var(--ios-radius-md); box-shadow: var(--ios-shadow-glass) !important; background: rgba(255, 255, 255, 0.98); backdrop-filter: var(--ios-blur);">
                        <div class="px-3 py-2 border-bottom mb-2">
                            <p class="font-weight-bold mb-0 small" style="color: var(--ios-text-primary);"><c:out value="${sessionScope.SESSION_USER_NAME}" default="Administrator" /></p>
                            <p class="text-muted small mb-0"><c:out value="${sessionScope.SESSION_USER_ROLE == 'ADMIN' ? 'Administrator' : 'Student'}" /></p>
                        </div>
                        
                        <c:if test="${sessionScope.SESSION_USER_ROLE == 'STUDENT'}">
                            <a class="dropdown-item rounded small font-weight-semibold py-2 d-flex align-items-center" href="${pageContext.request.contextPath}/app/student/profile">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                My Academic Profile
                            </a>
                            <a class="dropdown-item rounded small font-weight-semibold py-2 d-flex align-items-center" href="${pageContext.request.contextPath}/app/student/readiness-card">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                                Official Readiness Card
                            </a>
                            <div class="dropdown-divider"></div>
                        </c:if>

                        <c:if test="${sessionScope.SESSION_USER_ROLE == 'ADMIN'}">
                            <a class="dropdown-item rounded small font-weight-semibold py-2 d-flex align-items-center" href="${pageContext.request.contextPath}/app/admin/dashboard">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                                Admin Dashboard
                            </a>
                            <a class="dropdown-item rounded small font-weight-semibold py-2 d-flex align-items-center" href="${pageContext.request.contextPath}/app/admin/students">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                Student Directory
                            </a>
                            <div class="dropdown-divider"></div>
                        </c:if>

                        <form action="${pageContext.request.contextPath}/logout" method="post" class="p-0 m-0">
                            <input type="hidden" name="csrfToken" value="${sessionScope.CSRF_TOKEN}" />
                            <button type="submit" class="dropdown-item rounded small font-weight-bold py-2 text-danger d-flex align-items-center">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </c:when>
            <c:otherwise>
                <div class="d-flex align-items-center gap-2">
                    <a class="ios-btn-secondary mr-2" style="padding: 0.45rem 1.15rem; font-size: 0.85rem;" href="${pageContext.request.contextPath}/login">Sign In</a>
                    <a class="ios-btn-primary" style="padding: 0.45rem 1.15rem; font-size: 0.85rem;" href="${pageContext.request.contextPath}/register">Get Started &rarr;</a>
                </div>
            </c:otherwise>
        </c:choose>
    </div>
</header>

<!-- Full-Screen Mobile Navigation Overlay Drawer -->
<c:if test="${not empty sessionScope.SESSION_USER_ID}">
    <div class="ios-mobile-drawer" id="mobileNavDrawer" aria-hidden="true">
        <!-- Drawer Header with Brand & Cancel/Close Button -->
        <div class="ios-mobile-drawer-header px-3 px-md-4">
            <a class="ios-brand m-0" href="${pageContext.request.contextPath}/">
                <span class="ios-brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                </span>
                <span>SkillTrack</span>
            </a>
            <button type="button" class="ios-drawer-close-btn" id="mobileNavCloseBtn" aria-label="Cancel and Close Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- Drawer Scrollable Navigation Body -->
        <div class="ios-mobile-drawer-body">
            <div class="ios-mobile-section-title">Navigation Menu</div>
            <c:choose>
                <c:when test="${sessionScope.SESSION_USER_ROLE == 'ADMIN'}">
                    <a class="ios-mobile-link ${activeNav == 'admin-dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/dashboard">
                        <span class="ios-mobile-link-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        </span>
                        <span class="ios-mobile-link-text">Overview Dashboard</span>
                        <span class="ios-mobile-link-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'students' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/students">
                        <span class="ios-mobile-link-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </span>
                        <span class="ios-mobile-link-text">Student Directory</span>
                        <span class="ios-mobile-link-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'roles' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/roles">
                        <span class="ios-mobile-link-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                        </span>
                        <span class="ios-mobile-link-text">Target Roles Bank</span>
                        <span class="ios-mobile-link-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'skills' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/skills">
                        <span class="ios-mobile-link-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </span>
                        <span class="ios-mobile-link-text">Master Skills Bank</span>
                        <span class="ios-mobile-link-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'criteria' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/criteria">
                        <span class="ios-mobile-link-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        </span>
                        <span class="ios-mobile-link-text">Placement Cutoffs</span>
                        <span class="ios-mobile-link-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'cohort' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/cohort-summary">
                        <span class="ios-mobile-link-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                        </span>
                        <span class="ios-mobile-link-text">Cohort Intelligence</span>
                        <span class="ios-mobile-link-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                </c:when>
                <c:otherwise>
                    <a class="ios-mobile-link ${activeNav == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/dashboard">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg></span>
                        <span class="ios-mobile-link-text">Overview Dashboard</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'profile' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/profile">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
                        <span class="ios-mobile-link-text">Academic Profile</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'skills' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/skills">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></span>
                        <span class="ios-mobile-link-text">My Technical Skills</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'projects' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/projects">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg></span>
                        <span class="ios-mobile-link-text">Projects Portfolio</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'certifications' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/certifications">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg></span>
                        <span class="ios-mobile-link-text">Certifications</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'dsa' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/dsa">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg></span>
                        <span class="ios-mobile-link-text">DSA Milestones</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'tasks' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/tasks">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg></span>
                        <span class="ios-mobile-link-text">Action Checklist</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'skill-gap' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/skill-gap">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg></span>
                        <span class="ios-mobile-link-text">Role Skill Gap</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                    <a class="ios-mobile-link ${activeNav == 'placement-criteria' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/placement-criteria">
                        <span class="ios-mobile-link-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg></span>
                        <span class="ios-mobile-link-text">Company Cutoffs</span>
                        <span class="ios-mobile-link-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                    </a>
                </c:otherwise>
            </c:choose>
        </div>

        <!-- Drawer Footer: User Avatar ('A') & Account Controls at the very end/last -->
        <div class="ios-mobile-drawer-footer px-3 py-3 border-top">
            <div class="ios-mobile-user-card p-3 mb-2.5 d-flex align-items-center">
                <!-- Circular Avatar 'A' -->
                <div class="rounded-circle d-flex align-items-center justify-content-center font-weight-bold mr-3 flex-shrink-0" style="width: 44px; height: 44px; background: linear-gradient(135deg, #0071e3, #5856d6); color: #ffffff; font-size: 1.1rem; border: 2px solid #ffffff; box-shadow: 0 4px 12px rgba(0, 113, 227, 0.35);">
                    <c:choose>
                        <c:when test="${sessionScope.SESSION_USER_ROLE == 'ADMIN'}">A</c:when>
                        <c:otherwise><c:out value="${fn:substring(sessionScope.SESSION_USER_NAME != null ? sessionScope.SESSION_USER_NAME : 'S', 0, 1)}" /></c:otherwise>
                    </c:choose>
                </div>
                <div class="flex-grow-1 text-truncate">
                    <div class="font-weight-bold text-truncate" style="color: var(--ios-text-primary); font-size: 0.95rem;">
                        <c:out value="${sessionScope.SESSION_USER_NAME}" default="Administrator" />
                    </div>
                    <div class="small text-muted font-weight-500 text-truncate">
                        <c:out value="${sessionScope.SESSION_USER_ROLE == 'ADMIN' ? 'System Administrator' : 'Placement Candidate'}" />
                    </div>
                </div>
            </div>

            <form action="${pageContext.request.contextPath}/logout" method="post" class="p-0 m-0">
                <input type="hidden" name="csrfToken" value="${sessionScope.CSRF_TOKEN}" />
                <button type="submit" class="btn btn-block py-2.5 font-weight-bold d-flex align-items-center justify-content-center" style="background: rgba(239, 68, 68, 0.08); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.22); border-radius: 12px; font-size: 0.9rem; transition: var(--ios-ease);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="mr-2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    Sign Out
                </button>
            </form>
        </div>
    </div>

    <script>
    (function() {
        function initMobileNav() {
            var toggleBtn = document.getElementById('mobileNavToggleBtn');
            var closeBtn = document.getElementById('mobileNavCloseBtn');
            var drawer = document.getElementById('mobileNavDrawer');
            if (!drawer) return;

            function openMenu() {
                drawer.classList.add('is-open');
                drawer.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function closeMenu() {
                drawer.classList.remove('is-open');
                drawer.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (drawer.classList.contains('is-open')) {
                        closeMenu();
                    } else {
                        openMenu();
                    }
                });
            }

            if (closeBtn) {
                closeBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    closeMenu();
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
                    closeMenu();
                }
            });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMobileNav);
        } else {
            initMobileNav();
        }
    })();
    </script>
</c:if>
