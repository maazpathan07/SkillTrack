<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<c:if test="${directory.totalPages > 1}">
    <nav aria-label="Candidate directory pagination" class="mt-4">
        <ul class="pagination justify-content-center align-items-center mb-0" style="gap: 0.35rem;">
            <li class="page-item ${directory.currentPage == 1 ? 'disabled' : ''}">
                <a class="page-link d-inline-flex align-items-center" href="?page=${directory.currentPage - 1}&search=${param.search}&department=${param.department}&graduationYear=${param.graduationYear}&targetRoleId=${param.targetRoleId}&minCgpa=${param.minCgpa}&minReadiness=${param.minReadiness}&skillId=${param.skillId}&skillLevel=${param.skillLevel}" aria-label="Go to previous page" style="border-radius: var(--ios-radius-sm); font-size: 0.85rem; font-weight: 600; padding: 0.45rem 0.85rem; border: 1px solid #e2e8f0; color: #334155;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    Previous
                </a>
            </li>
            
            <c:forEach begin="1" end="${directory.totalPages}" var="p">
                <li class="page-item ${directory.currentPage == p ? 'active' : ''}">
                    <a class="page-link" href="?page=${p}&search=${param.search}&department=${param.department}&graduationYear=${param.graduationYear}&targetRoleId=${param.targetRoleId}&minCgpa=${param.minCgpa}&minReadiness=${param.minReadiness}&skillId=${param.skillId}&skillLevel=${param.skillLevel}" aria-label="Go to page ${p}" ${directory.currentPage == p ? 'aria-current="page"' : ''} style="border-radius: var(--ios-radius-sm); font-size: 0.85rem; font-weight: 600; padding: 0.45rem 0.85rem; min-width: 38px; text-align: center; border: 1px solid ${directory.currentPage == p ? 'var(--ios-blue)' : '#e2e8f0'}; background: ${directory.currentPage == p ? 'var(--ios-blue)' : '#ffffff'}; color: ${directory.currentPage == p ? '#ffffff' : '#334155'};">
                        <c:out value="${p}" />
                    </a>
                </li>
            </c:forEach>
            
            <li class="page-item ${directory.currentPage == directory.totalPages ? 'disabled' : ''}">
                <a class="page-link d-inline-flex align-items-center" href="?page=${directory.currentPage + 1}&search=${param.search}&department=${param.department}&graduationYear=${param.graduationYear}&targetRoleId=${param.targetRoleId}&minCgpa=${param.minCgpa}&minReadiness=${param.minReadiness}&skillId=${param.skillId}&skillLevel=${param.skillLevel}" aria-label="Go to next page" style="border-radius: var(--ios-radius-sm); font-size: 0.85rem; font-weight: 600; padding: 0.45rem 0.85rem; border: 1px solid #e2e8f0; color: #334155;">
                    Next
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="ml-1" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </li>
        </ul>
    </nav>
</c:if>
