<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block st-sidebar-wrapper collapse">
    <div class="position-sticky pt-3">
        <c:choose>
            <c:when test="${sessionScope.SESSION_USER_ROLE == 'ADMIN'}">
                <div class="st-sidebar-heading">
                    Admin Intelligence
                </div>
                <ul class="nav flex-column mb-3">
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'admin-dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/dashboard">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                            </span>
                            <span>Overview Dashboard</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'students' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/students">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </span>
                            <span>Student Directory</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'roles' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/roles">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                            </span>
                            <span>Target Roles Bank</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'skills' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/skills">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            </span>
                            <span>Master Skills Bank</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'criteria' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/criteria">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            </span>
                            <span>Placement Cutoffs</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'cohort' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/admin/cohort-summary">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            </span>
                            <span>Cohort Intelligence</span>
                        </a>
                    </li>
                </ul>
            </c:when>

            <c:otherwise>
                <div class="st-sidebar-heading">
                    Preparation Engines
                </div>
                <ul class="nav flex-column mb-3">
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/dashboard">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                            </span>
                            <span>Overview Dashboard</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'profile' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/profile">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </span>
                            <span>Academic Profile</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'skills' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/skills">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            </span>
                            <span>My Technical Skills</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'projects' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/projects">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                            </span>
                            <span>Projects Portfolio</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'certifications' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/certifications">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                            </span>
                            <span>Certifications</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'dsa' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/dsa">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                            </span>
                            <span>DSA Milestones</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'tasks' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/tasks">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                            </span>
                            <span>Action Checklist</span>
                        </a>
                    </li>
                </ul>

                <div class="st-sidebar-heading mt-3">
                    Evaluation & Reports
                </div>
                <ul class="nav flex-column mb-4">
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'skill-gap' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/skill-gap">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                            </span>
                            <span>Role Skill Gap</span>
                        </a>
                    </li>
                    <li class="st-nav-item">
                        <a class="st-nav-link ${activeNav == 'placement-criteria' ? 'active' : ''}" href="${pageContext.request.contextPath}/app/student/placement-criteria">
                            <span class="st-nav-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            </span>
                            <span>Company Cutoffs</span>
                        </a>
                    </li>
                </ul>
            </c:otherwise>
        </c:choose>
    </div>
</nav>
